# Base del backend (cinema-system-randomplay-backend), sin barra final.
# Lo usan los pedidos del servidor y el proxy /api. Con el mock: npm run mock:api
API_URL=http://127.0.0.1:4010

# Origen público del sitio, sin barra final. Se usa en canónicas, sitemap, robots y JSON-LD.
SITE_URL=http://localhost:3000

# TEMPORAL (spec 002): con API_MOCK=1 el sitio usa el catálogo de prueba local
# (scripts/mock-data/catalogo.json) en lugar del backend. Apagado en tests y CI.
API_MOCK=0
