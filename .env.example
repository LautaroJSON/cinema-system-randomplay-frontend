# Backend que usa el sitio: local (http://localhost:8080), hosteado (Render) o mock
# (http://127.0.0.1:4010, se levanta con npm run mock:api). Lo usan los pedidos del servidor y el
# proxy /api. Al cambiarlo, reiniciá npm run dev.
BACKEND=mock

# Opcional: otra URL para BACKEND=local, si tu backend no usa el 8080.
# API_URL_LOCAL=http://localhost:5165

# Opcional: una URL exacta, sin barra final. Si está definida, gana sobre BACKEND. La usan los
# despliegues y los e2e.
# API_URL=https://cinema-system-randomplay-backend.onrender.com

# Base del backend para el navegador, sin barra final. Se fija al compilar (next build). Con ella el
# navegador llama directo al backend, que tiene que aceptar este sitio por CORS; sin ella usa el
# proxy /api. Solo en producción: los previews tienen otro dominio y el backend no los acepta.
# NEXT_PUBLIC_API_URL=https://cinema-system-randomplay-backend.onrender.com

# Origen público del sitio, sin barra final. Se usa en canónicas, sitemap, robots y JSON-LD.
SITE_URL=http://localhost:3000

# TEMPORAL (spec 002): con API_MOCK=1 el sitio usa el catálogo de prueba local
# (scripts/mock-data/catalogo.json) en lugar del backend. Apagado en tests y CI.
API_MOCK=0

# Habilita la página de pago simulado (/carritos/{id}/pago-simulado) fuera de `next dev`. La usan
# los e2e, que corren con `next start`. Nunca activarla en producción.
# PAGO_SIMULADO=1
